<Window x:Class="PracticeApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="276" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="Авторизация" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Логин:"/>
        <TextBox Text="{Binding Username}" Margin="0,0,0,15" Padding="4"/>

        <TextBlock Text="Пароль:"/>
        <PasswordBox x:Name="UserPasswordBox" Margin="0,0,0,20" Padding="4"/>

        <Button Content="Войти" 
                Command="{Binding LoginCommand}" 
                CommandParameter="{Binding ElementName=UserPasswordBox}" 
                Height="35" FontSize="14" FontWeight="Bold" Background="#0078D7" Foreground="White"/>
    </StackPanel>
</Window>