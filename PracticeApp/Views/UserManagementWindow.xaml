<Window x:Class="PracticeApp.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление пользователями" Height="526" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F4F4F6">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="3" BorderBrush="#CCCCCC" BorderThickness="1" Background="White">
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" 
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                      BorderThickness="0" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID_Пользователя" Binding="{Binding IdUser}" Width="120"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                    <DataGridTextColumn Header="ID_Роли" Binding="{Binding IdRole}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="1" Text="ДАННЫЕ ПОЛЬЗОВАТЕЛЯ" Foreground="#4A65F6" 
                   FontWeight="Bold" FontSize="15" Margin="0,15,0,10" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="ЛОГИН" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox Text="{Binding UsernameInput, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

            <TextBlock Text="ПАРОЛЬ" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
            <TextBox Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}" Padding="5" Margin="0,0,0,10"/>

            <TextBlock Text="РОЛЬ" Foreground="Gray" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
            <ComboBox ItemsSource="{Binding AvailableRoles}" 
                      DisplayMemberPath="RoleName" 
                      SelectedValuePath="RoleId" 
                      SelectedValue="{Binding SelectedRoleId}" 
                      Padding="5" Margin="0,0,0,20"/>

            <Button Content="Применить" Command="{Binding ApplyCommand}" 
                    Height="35" Background="#3CB371" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,8">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Удалить" Command="{Binding DeleteCommand}" 
                        Height="35" Background="#DC143C" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="Отмена" Command="{Binding CancelCommand}" 
                        Height="35" Background="#006400" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>