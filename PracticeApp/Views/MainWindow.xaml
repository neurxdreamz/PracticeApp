<Window x:Class="PracticeApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Управление производством - Детали" Height="581" Width="1100">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#4169E1" Padding="20,0">
            <Grid>
                <TextBlock Text="УПРАВЛЕНИЕ ПРОИЗВОДСТВОМ" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,20,0">
                        <TextBlock Text="Роль: " Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentUserRoleName}" 
                                   Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <Button Content="Выйти из аккаунта" 
                            Command="{Binding LogoutCommand}"
                            Background="#00BFFF" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Padding="15,5" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel>
                <TextBlock Text="ТАБЛИЦА" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox SelectedIndex="{Binding SelectedTableIndex}" Margin="0,0,0,20" Padding="5">
                    <ComboBoxItem Content="Детали"/>
                    <ComboBoxItem Content="Рабочие"/>
                    <ComboBoxItem Content="Участки"/>
                    <ComboBoxItem Content="Смены"/>
                </ComboBox>

                <TextBlock Text="ПОИСК" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" Padding="5" />

                <TextBlock Text="УПРАВЛЕНИЕ" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>

                <Button Content="+ Добавить" Command="{Binding GlobalAddCommand}" 
                        Background="#3CB371" Foreground="White" FontWeight="Bold" 
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" 
                        Height="40" Margin="0,0,0,10" BorderThickness="0"/>

                <Button Content="Редактировать" Command="{Binding GlobalEditCommand}" 
                        Background="#4169E1" Foreground="White" FontWeight="Bold" 
                        Visibility="{Binding IsEditor, Converter={StaticResource BoolToVis}}" 
                        Height="40" Margin="0,0,0,10" BorderThickness="0"/>

                <Button Content="x Удалить" Command="{Binding GlobalDeleteCommand}" 
                        Background="#DC143C" Foreground="White" FontWeight="Bold" 
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" 
                        Height="40" Margin="0,0,0,10" BorderThickness="0"/>

                <Button Content="Управление пользователями" 
                        Command="{Binding OpenUserManagementCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        Height="35" Background="#7B68EE" Foreground="White" FontWeight="Bold" 
                        BorderThickness="0" Margin="0,0,0,10"/>

                <Button Content="Сформировать PDF отчет" 
                        Command="{Binding ExportToPdfCommand}"
                        Height="35" Background="#4A65F6" Foreground="White" FontWeight="Bold" 
                        BorderThickness="0" Margin="0,0,0,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Command="{Binding RefreshCommand}" 
                    HorizontalAlignment="Right" Margin="0,0,0,10"
                    Background="Transparent" BorderThickness="1" BorderBrush="#B0C4DE"
                    Foreground="#4169E1" Padding="10,5" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↻" FontSize="16" FontWeight="Bold" Margin="0,-2,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Обновить" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTableIndex}" BorderThickness="0" Background="Transparent">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabItem>
                    <DataGrid ItemsSource="{Binding Details}" SelectedItem="{Binding SelectedDetail}" 
                              FontWeight="Normal" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdRecord}" Width="50"/>
                            <DataGridTextColumn Header="Название детали" Binding="{Binding DetailName}" Width="150"/>
                            <DataGridTextColumn Header="Объем партии" Binding="{Binding BatchVolume}" Width="100"/>

                            <DataGridTextColumn Header="Норма времени" Binding="{Binding TimeNorm}" Width="110"/>
                            <DataGridTextColumn Header="Дата изготовления" Binding="{Binding ManufactureDate, StringFormat={}{0:dd.MM.yyyy}}" Width="140"/>

                            <DataGridTextColumn Header="Участок" Binding="{Binding SectorName}" Width="150"/>
                            <DataGridTextColumn Header="Рабочий" Binding="{Binding WorkerFullName}" Width="150"/>
                            <DataGridTextColumn Header="Смена №" Binding="{Binding ShiftNumber}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem>
                    <DataGrid ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}" 
                              FontWeight="Normal" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdWorker}" Width="50"/>
                            <DataGridTextColumn Header="ФИО Рабочего" Binding="{Binding FullName}" Width="200"/>
                            <DataGridTextColumn Header="Специальность" Binding="{Binding Specialty}" Width="150"/>
                            <DataGridTextColumn Header="Разряд" Binding="{Binding Grade}" Width="80"/>
                            <DataGridTextColumn Header="Тарифная ставка" Binding="{Binding TariffRate, StringFormat={}{0:N2} ₽}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem>
                    <DataGrid ItemsSource="{Binding Sectors}" 
                              SelectedItem="{Binding SelectedSector}" 
                              FontWeight="Normal" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdSector}" Width="50"/>
                            <DataGridTextColumn Header="Название участка" Binding="{Binding SectorName}" Width="150"/>
                            <DataGridTextColumn Header="ФИО Начальника" Binding="{Binding ManagerFullName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem>
                    <DataGrid ItemsSource="{Binding Shifts}" 
                              SelectedItem="{Binding SelectedShift}" 
                              FontWeight="Normal" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdShift}" Width="50"/>
                            <DataGridTextColumn Header="Номер смены" Binding="{Binding ShiftNumber}" Width="120"/>
                            <DataGridTextColumn Header="ФИО Бригадира" Binding="{Binding Foreman}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>