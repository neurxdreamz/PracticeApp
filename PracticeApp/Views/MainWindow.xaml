<Window x:Class="PracticeApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Управление производством - Детали" Height="450" Width="800">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Поиск: " VerticalAlignment="Center" FontWeight="Bold" Foreground="#333" Margin="0,0,5,0"/>

            <TextBox Grid.Column="1" 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="4" 
                     VerticalContentAlignment="Center"
                     ToolTip="Введите название детали, ФИО рабочего или участок для фильтрации..."/>
        </Grid>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить деталь" Command="{Binding OpenAddWindowCommand}" 
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" 
                    Width="120" Margin="0,0,10,0" Padding="5"/>

            <Button Content="Редактировать" Command="{Binding OpenEditWindowCommand}" 
                    Visibility="{Binding IsEditor, Converter={StaticResource BoolToVis}}" 
                    Width="120" Margin="0,0,10,0" Padding="5"/>

            <Button Content="Удалить" Command="{Binding DeleteDetailCommand}" 
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" 
                    Width="100" Margin="0,0,10,0" Padding="5"/>

            <Button Content="Обновить" Command="{Binding RefreshCommand}" 
                    Width="100" Padding="5"/>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="0,5,0,0">

            <TabItem Header="Детали" FontSize="14" FontWeight="Normal">
                <DataGrid ItemsSource="{Binding Details}" 
                          SelectedItem="{Binding SelectedDetail}" 
                          FontWeight="Normal" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single"
                          Margin="5" SelectionChanged="DataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdRecord}" Width="50"/>
                        <DataGridTextColumn Header="Название детали" Binding="{Binding DetailName}" Width="*"/>
                        <DataGridTextColumn Header="Объем партии" Binding="{Binding BatchVolume}" Width="100"/>
                        <DataGridTextColumn Header="Участок" Binding="{Binding SectorName}" Width="150"/>
                        <DataGridTextColumn Header="Рабочий" Binding="{Binding WorkerFullName}" Width="200"/>
                        <DataGridTextColumn Header="Смена №" Binding="{Binding ShiftNumber}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Рабочие" FontSize="14" FontWeight="Normal">
                <DataGrid ItemsSource="{Binding Workers}" 
                          FontWeight="Normal" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdWorker}" Width="50"/>
                        <DataGridTextColumn Header="ФИО Рабочего" Binding="{Binding FullName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Участки" FontSize="14" FontWeight="Normal">
                <DataGrid ItemsSource="{Binding Sectors}" 
                          FontWeight="Normal" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdSector}" Width="50"/>
                        <DataGridTextColumn Header="Название участка" Binding="{Binding SectorName}" Width="150"/>

                        <DataGridTextColumn Header="ФИО Начальника" Binding="{Binding Supervisor}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Смены" FontSize="14" FontWeight="Normal">
                <DataGrid ItemsSource="{Binding Shifts}" 
                          FontWeight="Normal" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdShift}" Width="50"/>
                        <DataGridTextColumn Header="Номер смены" Binding="{Binding ShiftNumber}" Width="120"/>
                        <DataGridTextColumn Header="ФИО Бригадира" Binding="{Binding Foreman}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>