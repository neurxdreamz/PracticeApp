<Window x:Class="PracticeApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Управление производством - Детали" Height="450" Width="800">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#4169E1" Padding="20,0">
            <Grid>
                <TextBlock Text="УПРАВЛЕНИЕ ПРОИЗВОДСТВОМ" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Роль: Администратор" Foreground="White" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <Button Content="Выйти из аккаунта" Background="#00BFFF" Foreground="White" BorderThickness="0" Padding="15,8" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel>
                <TextBlock Text="ТАБЛИЦА" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox SelectedIndex="{Binding SelectedTableIndex}" Margin="0,0,0,20" Padding="5">
                    <ComboBoxItem Content="Детали"/>
                    <ComboBoxItem Content="Рабочие"/>
                    <ComboBoxItem Content="Участки"/>
                    <ComboBoxItem Content="Смены"/>
                </ComboBox>

                <TextBlock Text="ПОИСК" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Padding="5" />
                <Button Content="Найти" BorderBrush="#4169E1" Foreground="#4169E1" Background="White" Padding="5" Margin="0,0,0,30" FontWeight="Bold"/>

                <TextBlock Text="УПРАВЛЕНИЕ" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>

                <Button Content="+ Добавить" Command="{Binding GlobalAddCommand}" 
                        Background="#3CB371" Foreground="White" FontWeight="Bold" 
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" 
                        Height="40" Margin="0,0,0,10" BorderThickness="0"/>

                <Button Content="Редактировать" Command="{Binding GlobalEditCommand}" 
                        Background="#4169E1" Foreground="White" FontWeight="Bold" 
                        Visibility="{Binding IsEditor, Converter={StaticResource BoolToVis}}" 
                        Height="40" Margin="0,0,0,10" BorderThickness="0"/>

                <Button Content="x Удалить" Command="{Binding GlobalDeleteCommand}" 
                        Background="#DC143C" Foreground="White" FontWeight="Bold" 
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" 
                        Height="40" Margin="0,0,0,30" BorderThickness="0"/>

                <Button Content="Обновить данные" Command="{Binding RefreshCommand}" 
                        Background="White" BorderBrush="#E0E0E0" Padding="10" Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding SelectedTableIndex}" Margin="10" BorderThickness="0" Background="Transparent">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabItem>
                <DataGrid ItemsSource="{Binding Details}" SelectedItem="{Binding SelectedDetail}" 
                          FontWeight="Normal" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdRecord}" Width="50"/>
                        <DataGridTextColumn Header="Название детали" Binding="{Binding DetailName}" Width="*"/>
                        <DataGridTextColumn Header="Объем партии" Binding="{Binding BatchVolume}" Width="100"/>
                        <DataGridTextColumn Header="Участок" Binding="{Binding SectorName}" Width="150"/>
                        <DataGridTextColumn Header="Рабочий" Binding="{Binding WorkerFullName}" Width="200"/>
                        <DataGridTextColumn Header="Смена №" Binding="{Binding ShiftNumber}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem>
                <DataGrid ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}" 
                          FontWeight="Normal" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdWorker}" Width="50"/>
                        <DataGridTextColumn Header="ФИО Рабочего" Binding="{Binding FullName}" Width="200"/>
                        <DataGridTextColumn Header="Специальность" Binding="{Binding Specialty}" Width="150"/>
                        <DataGridTextColumn Header="Разряд" Binding="{Binding Grade}" Width="80"/>
                        <DataGridTextColumn Header="Тарифная ставка" Binding="{Binding TariffRate, StringFormat={}{0:N2} ₽}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem>
                <DataGrid ItemsSource="{Binding Sectors}" FontWeight="Normal" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdSector}" Width="50"/>
                        <DataGridTextColumn Header="Название участка" Binding="{Binding SectorName}" Width="150"/>
                        <DataGridTextColumn Header="ФИО Начальника" Binding="{Binding Supervisor}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem>
                <DataGrid ItemsSource="{Binding Shifts}" FontWeight="Normal" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdShift}" Width="50"/>
                        <DataGridTextColumn Header="Номер смены" Binding="{Binding ShiftNumber}" Width="120"/>
                        <DataGridTextColumn Header="ФИО Бригадира" Binding="{Binding Foreman}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>